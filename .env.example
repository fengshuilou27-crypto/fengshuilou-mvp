# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── 观点自动更新管道（服务端专用，勿暴露到前端）─────────────────
YOUTUBE_API_KEY=          # YouTube Data API v3（頻道發現；開放網絡必填）
KIMI_API_KEY=             # Moonshot API key（結構化+聯網搜索+OCR 都靠佢）
# 注意：Moonshot 分兩站，key 互不通用——
#   國內站 platform.moonshot.cn 開嘅 key → KIMI_BASE_URL=https://api.moonshot.cn/v1
#   國際站 platform.moonshot.ai 開嘅 key → KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=               # 可選：覆蓋結構化模型（唔設則行候選鏈 kimi-k2.6→kimi-k3）
NEWS_API_KEY=             # 預留
BRAVE_API_KEY=            # Brave Search（開放網絡先用到）

# ── 訪問門禁密碼（發布後憑此密碼進入；留空則關閉門禁）─────────────
ACCESS_CODE=

# ── agent-gw 憑證（可選：唔設則讀 ~/.kimi/agent-gw.json）──────────
# AGENT_GW_API_KEY=
# AGENT_GW_BASE_URL=

# Supadata 字幕 API（YouTube 封雲端 IP 後嘅伺服器字幕主力；免費 100 次/月）
# 申請：https://supadata.ai → dashboard → API key
SUPADATA_API_KEY=
